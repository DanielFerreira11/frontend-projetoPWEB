{
  "compilerOptions": {
    "target": "es2017",
    "module": "commonjs",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "importHelpers": true,
    "resolveJsonModule": true,  
    "outDir": "./lib"
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
